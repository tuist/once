{
  "name": "hello-world",
  "projectType": "application",
  "sourceRoot": "apps/hello-world/src",
  "implicitDependencies": ["greeter"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/hello-world"],
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "mkdir -p dist/apps/hello-world",
          "cp apps/hello-world/src/index.js dist/apps/hello-world/"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/hello-world/src/index.js"
      }
    }
  }
}
