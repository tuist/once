<Layouts.app flash={@flash}>
  <section data-part="passport-page">
    <header data-part="passport-header">
      <nav data-part="passport-breadcrumb" aria-label="Breadcrumb">
        <a href="/github.com/tuist/once">Passport</a>
        <span>/</span>
        <a href={"https://github.com/#{@account}"} target="_blank" rel="noopener">{@account}</a>
        <span>/</span>
        <span>{@repository}</span>
      </nav>
      <div data-part="passport-heading-row">
        <div>
          <h1>{@account}/{@repository}</h1>
          <p>{@github_description}</p>
        </div>
        <Button.button
          label="Integrate Once"
          variant="primary"
          size="medium"
          href={"/github.com/#{@account}/#{@repository}/integrate"}
        />
      </div>
    </header>

    <Card.card icon="circle_check" title="Compatibility" data-part="passport-card">
      <:actions>
        <Badge.status_badge status="success" label="Compatible" />
      </:actions>
      <Card.card_section>
        <div data-part="passport-metadata">
          <div><span>Score</span><strong>{@score}/100</strong></div>
          <div><span>Estimated savings</span><strong>{@estimated_savings}</strong></div>
          <div><span>Last checked</span><strong>{@checked_at}</strong></div>
          <div><span>Branch</span><strong>{@default_branch}</strong></div>
        </div>
      </Card.card_section>
      <Card.card_section>
        <p data-part="passport-card-copy">{@summary}</p>
      </Card.card_section>
    </Card.card>

    <Card.card icon="git_branch" title="Most recent action graph" data-part="passport-card">
      <:actions>
        <Badge.status_badge
          status="success"
          label={"#{@graph["summary"]["cached_actions"]}/#{@graph["summary"]["actions"]} cached"}
        />
      </:actions>
      <Card.card_section>
        <div data-part="passport-graph" data-passport-graph={Jason.encode!(@graph)}>
          <svg aria-label="Repository action graph" role="img"></svg>
          <div data-part="graph-inspector">Select an action to inspect its Once metadata.</div>
        </div>
        <dl data-part="passport-graph-metadata">
          <div>
            <dt>Critical path</dt><dd>{@graph["summary"]["critical_path_ms"] / 1000}s</dd>
          </div>
          <div>
            <dt>Artifacts</dt><dd>
              {Float.round(@graph["summary"]["artifact_bytes"] / 1_000_000, 1)} MB
            </dd>
          </div>
          <div>
            <dt>History</dt><dd>{@graph_analysis["observed_commits"]} default-branch commits</dd>
          </div>
        </dl>
      </Card.card_section>
    </Card.card>

    <Card.card icon="sparkles" title="Optimization candidates" data-part="passport-card">
      <Card.card_section>
        <ol data-part="passport-candidates">
          <li :for={candidate <- @graph_analysis["candidates"]}>
            <div><strong>{candidate["target"]}</strong><span>{candidate["reason"]}</span></div>
            <div data-part="candidate-metrics">
              <span>{candidate["dependent_targets"]} dependent targets</span><span>{candidate[
                "invalidated_actions"
              ]} invalidated actions</span>
            </div>
            <p>{candidate["recommendation"]}</p>
          </li>
        </ol>
      </Card.card_section>
    </Card.card>

    <div data-part="passport-columns">
      <Card.card
        icon="checkup_list"
        title="Recommended for this repository"
        data-part="passport-card"
      >
        <Card.card_section>
          <ul data-part="passport-feature-list">
            <li :for={{name, detail} <- @features}>
              <Badge.badge label="Ready" color="success" style="light-fill" />
              <div><strong>{name}</strong><span>{detail}</span></div>
            </li>
          </ul>
        </Card.card_section>
      </Card.card>

      <Card.card icon="git_branch" title="Native project integration" data-part="passport-card">
        <:actions>
          <Badge.status_badge
            status={if @integration.status == :queued, do: "in_progress", else: "attention"}
            label={@integration.label}
          />
        </:actions>
        <Card.card_section>
          <p data-part="passport-card-copy">{@integration.detail}</p>
          <Button.link_button
            :if={@integration.status in [:not_requested, :awaiting_access]}
            label={
              if @integration.status == :not_requested,
                do: "Request integration",
                else: "Grant access"
            }
            href={"/github.com/#{@account}/#{@repository}/integrate"}
            variant="primary"
            size="medium"
          />
        </Card.card_section>
      </Card.card>
    </div>

    <Card.card icon="versions" title="Scan history" data-part="passport-card">
      <Card.card_section>
        <div data-part="passport-history-table">
          <div data-part="passport-history-row" data-variant="header">
            <span>Revision</span><span>Result</span><span>Finding</span>
          </div>
          <div :for={{version, status, detail} <- @versions} data-part="passport-history-row">
            <code>{version}</code><Badge.status_badge status="success" label={status} /><span>{detail}</span>
          </div>
        </div>
      </Card.card_section>
    </Card.card>
  </section>
</Layouts.app>
