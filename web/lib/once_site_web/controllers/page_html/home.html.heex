<Layouts.app flash={@flash}>
  <section data-part="hero">
    <div data-part="hero-glow"></div>
    <a
      data-part="oss-badge"
      href="https://github.com/tuist/once"
      target="_blank"
      rel="noopener"
    >
      <span data-part="oss-icon">{Phoenix.HTML.raw(github_icon())}</span>
      <span>Open source</span>
      <span data-part="oss-sep"></span>
      <span data-part="oss-muted">MIT licensed</span>
    </a>
    <h1>Build once.<br />Reuse everywhere.</h1>
    <p data-part="lede">
      Once gives every action explicit inputs, outputs, and environment, so results are
      content-addressed, cached, and reusable across developers, coding agents, continuous
      integration, and machines. Build it once, and never build it again.
    </p>
    <div data-part="hero-actions">
      <a data-part="button" data-variant="primary" href="/docs/guide/getting-started">
        Get started
      </a>
      <a data-part="button" data-variant="secondary" href="/docs">Read the docs</a>
      <a
        data-part="button"
        data-variant="secondary"
        href="https://discord.gg/fTpB5e3rRp"
        target="_blank"
        rel="noopener"
      >
        Join Discord
      </a>
    </div>

    <div data-part="terminal" id="home-terminal" aria-label="Once build examples">
      <div data-part="terminal-bar">
        <span data-part="terminal-dot"></span>
        <span data-part="terminal-dot"></span>
        <span data-part="terminal-dot"></span>
        <div data-part="terminal-tabs" role="tablist">
          <button
            :for={{term, index} <- Enum.with_index(terminals())}
            type="button"
            data-part="terminal-tab"
            data-index={index}
            data-active={to_string(index == 0)}
          >
            <span data-part="tab-icon" data-lang={term.icon} aria-hidden="true"></span>
            {term.label}
          </button>
        </div>
      </div>
      <div data-part="terminal-panels">
        <pre
          :for={{term, index} <- Enum.with_index(terminals())}
          data-part="terminal-panel"
          data-index={index}
          data-active={to_string(index == 0)}
        ><code><span data-part="prompt">$</span> {term.command}
target     {term.target}
cache key  {term.cache}
result     <span data-part={term.result}>{term.result}</span>
duration   {term.duration}</code></pre>
      </div>
    </div>
  </section>

  <section data-part="features" aria-label="How Once works">
    <a :for={feature <- features()} data-part="feature-card" href={feature.link}>
      <div data-part="image">
        <span data-part="title">{feature.title}</span>
        <div data-part="icon">{Phoenix.HTML.raw(feature.icon)}</div>
      </div>
      <div data-part="body">
        <p>{feature.details}</p>
        <span data-part="feature-cta">Learn more →</span>
      </div>
    </a>
  </section>

  <section data-part="languages" aria-label="Supported languages">
    <p data-part="section-eyebrow">Works with your stack</p>
    <h2>Natively supported languages and ecosystems</h2>
    <p data-part="section-copy">
      Cache and reuse builds and tests across the tools your teams already ship with.
    </p>
    <div data-part="language-grid">
      <a :for={lang <- languages()} data-part="language-chip" href={lang.link}>
        <span data-part="lang-icon" data-lang={lang.icon} aria-hidden="true"></span>
        <span>{lang.name}</span>
      </a>
    </div>
  </section>
</Layouts.app>
